<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shanzhu.book.mapper.UserMapper">
    <resultMap id="BaseResultMap" type="com.shanzhu.book.model.User">
        <id column="userId" jdbcType="INTEGER" property="userid" />
        <result column="userName" jdbcType="VARCHAR" property="username" />
        <result column="studentId" jdbcType="VARCHAR" property="studentid" />
        <result column="userPassword" jdbcType="VARCHAR" property="userpassword" />
        <result column="isAdmin" jdbcType="INTEGER" property="isadmin" />
        <result column="status" jdbcType="INTEGER" property="status" />
        <result column="gender" jdbcType="INTEGER" property="gender" />
        <result column="open_id" jdbcType="VARCHAR" property="openId" />
        <result column="department" jdbcType="VARCHAR" property="department" />

        <result column="credit_score" jdbcType="INTEGER" property="creditScore" />
    </resultMap>

    <sql id="Base_Column_List">
        userId, userName, studentId, userPassword, isAdmin, status, gender, open_id, department, credit_score
    </sql>

    <select id="selectByUserName" resultMap="BaseResultMap">
        select <include refid="Base_Column_List" />
        from user
        where studentId = #{username}
    </select>

    <select id="selectCountByUserName" resultType="java.lang.Integer">
        select count(*) from user where studentId = #{username}
    </select>

    <insert id="insert" parameterType="com.shanzhu.book.model.User">
        insert into user (userName, studentId, userPassword, isAdmin, status, gender, department)
        values (#{username}, #{studentid}, #{userpassword}, #{isadmin}, #{status}, #{gender}, #{department})
    </insert>

    <update id="updateByPrimaryKeySelective" parameterType="com.shanzhu.book.model.User">
        update user
        <set>
            <if test="username != null"> userName = #{username}, </if>
            <if test="studentid != null"> studentId = #{studentid}, </if>
            <if test="userpassword != null"> userPassword = #{userpassword}, </if>
            <if test="isadmin != null"> isAdmin = #{isadmin}, </if>
            <if test="status != null"> status = #{status}, </if>
            <if test="gender != null"> gender = #{gender}, </if>
            <if test="openId != null"> open_id = #{openId}, </if>
            <if test="department != null"> department = #{department}, </if>

            <if test="creditScore != null"> credit_score = #{creditScore}, </if>
        </set>
        where userId = #{userid}
    </update>

    <select id="selectAllByLimit" resultMap="BaseResultMap">
        select <include refid="Base_Column_List" /> from user
        <where>
            <if test="username != null and username != ''">
                and (userName like concat('%',#{username},'%') OR studentId like concat('%',#{username},'%'))
            </if>
            <if test="department != null and department != ''">
                and department = #{department}
            </if>
        </where>
        order by status asc, userId desc
        limit #{begin}, #{size}
    </select>

    <select id="selectCount" resultType="int">
        select count(*) from user
        <where>
            <if test="username != null and username != ''">
                and (userName like concat('%',#{username},'%') OR studentId like concat('%',#{username},'%'))
            </if>
            <if test="department != null and department != ''">
                and department = #{department}
            </if>
        </where>
    </select>

    <select id="selectByPrimaryKey" resultMap="BaseResultMap">
        select <include refid="Base_Column_List" /> from user where userId = #{userid}
    </select>

    <delete id="deleteByPrimaryKey">
        delete from user where userId = #{userid}
    </delete>
</mapper>